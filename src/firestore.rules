
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------------------//
    //                      HELPER FUNCTIONS                           //
    // ----------------------------------------------------------------//

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isShopOwner(shopId) {
      return isSignedIn() &&
        (request.auth.uid == shopId ||
         (exists(/databases/$(database)/documents/shops/$(shopId)) && 
          get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId == request.auth.uid));
    }
    
    function isEmployee(shopId) {
      return isSignedIn() && exists(/databases/$(database)/documents/shops/$(shopId)/employees/$(request.auth.uid));
    }
    
    function isOwnerOrEmployee(shopId) {
      return isShopOwner(shopId) || isEmployee(shopId);
    }
    
    function isOwnerOfResourceShop() {
      let shopId = request.resource.data.shopId;
      return shopId != null && isShopOwner(shopId);
    }
    
    // ----------------------------------------------------------------//
    //                          GLOBAL RULES                           //
    // ----------------------------------------------------------------//

    match /users/{userId} {
      allow read: if isSelf(userId) || isShopOwner(resource.data.shopId);
      allow create: if request.auth.token.email == request.resource.data.email;
      allow update: if isSelf(userId);
      allow delete: if isSelf(userId);
    }
    
    match /platform_config/{docId} {
        allow read: if true;
        allow write: if false; // Should be managed by super admin only
    }

    // ----------------------------------------------------------------//
    //                     SHOP-SPECIFIC RULES                         //
    // ----------------------------------------------------------------//
    
    match /shops/{shopId} {
      allow get: if isOwnerOrEmployee(shopId);
      allow list: if isSignedIn();
      allow create: if isSelf(shopId) && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isShopOwner(shopId);

      match /employees/{employeeId} {
        allow create: if isShopOwner(shopId);
        allow read, list: if isOwnerOrEmployee(shopId) || isSelf(employeeId);
        allow update: if isShopOwner(shopId) || (isSelf(employeeId) && !('role' in request.resource.data));
        allow delete: if isShopOwner(shopId);
      }

      match /attendance/{attendanceId} {
        allow create: if isEmployee(shopId) && request.resource.data.userId == request.auth.uid;
        allow read: if isOwnerOrEmployee(shopId);
        allow list: if (isEmployee(shopId) && request.query.where.userId == request.auth.uid) || isShopOwner(shopId);
        allow update: if isShopOwner(shopId) || (isEmployee(shopId) && resource.data.userId == request.auth.uid);
        allow delete: if isShopOwner(shopId);
      }
      
      match /leaveRequests/{leaveId} {
          allow create: if isEmployee(shopId) && request.resource.data.userId == request.auth.uid;
          allow read, list: if isOwnerOrEmployee(shopId);
          allow update, delete: if isShopOwner(shopId);
      }
      
      match /announcements/{announcementId} {
        allow read: if isOwnerOrEmployee(shopId);
        allow write: if isShopOwner(shopId);
      }

      match /qr-history/{docId} {
        allow read, write: if isShopOwner(shopId);
      }
      match /config/{docId} {
        allow read: if isOwnerOrEmployee(shopId);
        allow write: if isShopOwner(shopId);
      }
      match /shifts/{shiftId} {
        allow read, write: if isShopOwner(shopId);
      }
      match /invites/{inviteId} {
          allow read: if true;
          allow create: if isShopOwner(shopId);
          allow update: if request.auth.token.email == resource.data.email;
      }
    }
    
    // ----------------------------------------------------------------//
    //                  COLLECTION GROUP QUERIES                       //
    // ----------------------------------------------------------------//
    
    match /{path=**}/employees/{employeeId} {
      allow list: if isSignedIn() && isShopOwner(resource.data.shopId);
    }
    
    match /{path=**}/attendance/{attendanceId} {
      allow list: if (isSignedIn() && request.query.where.userId == request.auth.uid) ||
                     (isSignedIn() && isShopOwner(resource.data.shopId));
    }
    match /{path=**}/leaveRequests/{leaveId} {
      allow list: if isSignedIn() && isShopOwner(resource.data.shopId);
    }
  }
}
