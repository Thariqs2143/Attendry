
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------------------//
    //                      HELPER FUNCTIONS                           //
    // ----------------------------------------------------------------//

    // Returns true if the user is signed in.
    function isSignedIn() {
      return request.auth != null;
    }

    // Returns true if the requesting user's UID matches the provided userId.
    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Returns true if the user is the owner of the shop document.
    // The owner's UID is used as the shop's document ID or stored in ownerId.
    function isShopOwner(shopId) {
      return isSignedIn() &&
        (request.auth.uid == shopId ||
         request.auth.uid == get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId);
    }

    // Returns true if the user is listed in the specified shop's 'employees' subcollection.
    function isEmployee(shopId) {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/shops/$(shopId)/employees/$(request.auth.uid)) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Employee' &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.shopId == shopId
        )
      );
    }

    // Returns true if the user has either owner or employee permissions for a given shop.
    function isOwnerOrEmployee(shopId) {
      return isShopOwner(shopId) || isEmployee(shopId);
    }

    // Returns true if a user making a write request is the owner of the shop
    // that the resource belongs to. Used for collectionGroup queries.
    function isOwnerOfResourceShop() {
      return isSignedIn() &&
             resource.data.shopId != null &&
             isShopOwner(resource.data.shopId);
    }

    // Super Admin checks
    function isSuperAdminByUID() {
      return request.auth.uid == "9x42M1n2aPVAH8ygeZt1Jc3A4e52";
    }

    function isSuperAdminByPhone() {
      return request.auth.token.phone_number == "+919790296771";
    }

    function isSuperAdmin() {
      return isSuperAdminByUID() || isSuperAdminByPhone();
    }

    // Employee lookup helper
    function getEmployeeId() {
      let phone = request.auth.token.phone_number;
      return get(/databases/$(database)/documents/employee_phone_to_shop_lookup/$(phone)).data.employeeDocId;
    }

    function isOwnEmployeeDocument(shopId, employeeId) {
      let phone = request.auth.token.phone_number;
      return exists(/databases/$(database)/documents/employee_phone_to_shop_lookup/$(phone)) &&
             get(/databases/$(database)/documents/employee_phone_to_shop_lookup/$(phone)).data.shopId == shopId &&
             get(/databases/$(database)/documents/employee_phone_to_shop_lookup/$(phone)).data.employeeDocId == employeeId;
    }

    // ----------------------------------------------------------------//
    //                          GLOBAL RULES                           //
    // ----------------------------------------------------------------//

    match /users/{userId} {
      allow list: if true;
      allow read: if isSelf(userId) ||
                     isShopOwner(resource.data.shopId) ||
                     isSuperAdmin();
      // Allow user creation if it's the user themselves, OR if a shop owner is creating an employee for their shop.
      allow create: if isSelf(userId) ||
                       (isSignedIn() && request.resource.data.shopId != null && isShopOwner(request.resource.data.shopId));
      allow update: if isSelf(userId) || isSuperAdmin();
      allow delete: if isSelf(userId) || isSuperAdmin();
    }

    match /employee_phone_to_shop_lookup/{phone} {
      allow get, read: if true; // Needed for login/signup
      allow create: if isSignedIn() &&
                    (isShopOwner(request.resource.data.shopId) ||
                     !exists(/databases/$(database)/documents/employee_phone_to_shop_lookup/$(phone)));
      allow update: if isShopOwner(request.resource.data.shopId) ||
                       request.auth.token.phone_number == phone;
      allow delete: if isShopOwner(resource.data.shopId) || isSuperAdmin();
    }

    match /platform_config/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ----------------------------------------------------------------//
    //                     SHOP-SPECIFIC RULES                         //
    // ----------------------------------------------------------------//

    match /shops/{shopId} {
      allow get: if isOwnerOrEmployee(shopId) || isSuperAdmin();
      allow list: if isSignedIn() || isSuperAdmin();
      allow create: if isSelf(shopId) && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isShopOwner(shopId) || isSuperAdmin();

      // Employees subcollection
      match /employees/{employeeId} {
        allow create: if isShopOwner(shopId) || isSuperAdmin();
        allow read: if isOwnerOrEmployee(shopId) ||
                       isSelf(employeeId) ||
                       isOwnEmployeeDocument(shopId, employeeId) ||
                       (request.auth.token.phone_number != null && employeeId == getEmployeeId()) ||
                       isSuperAdmin();
        allow update: if isShopOwner(shopId) ||
                         isSelf(employeeId) ||
                         isOwnEmployeeDocument(shopId, employeeId) ||
                         (request.auth.token.phone_number != null && employeeId == getEmployeeId()) ||
                         isSuperAdmin();
        allow delete: if isShopOwner(shopId) || isSuperAdmin();
      }

      // Attendance subcollection
      match /attendance/{attendanceId} {
        allow create: if isEmployee(shopId) && request.resource.data.userId == request.auth.uid
                       || isShopOwner(shopId)
                       || isSuperAdmin();
        allow read, list: if isOwnerOrEmployee(shopId) || isSuperAdmin();
        allow update: if isShopOwner(shopId) ||
                         (isEmployee(shopId) && resource.data.userId == request.auth.uid) ||
                         isSuperAdmin();
        allow delete: if isShopOwner(shopId) || isSuperAdmin();
      }

      // Leave Requests
      match /leaveRequests/{leaveId} {
        allow create: if (isEmployee(shopId) && request.resource.data.userId == request.auth.uid) ||
                         isSuperAdmin();
        allow read, list: if isOwnerOrEmployee(shopId) || isSuperAdmin();
        allow update, delete: if isShopOwner(shopId) || isSuperAdmin();
      }

      // QR History
      match /qr-history/{docId} {
        allow read, write: if isShopOwner(shopId) || isSuperAdmin();
      }

      // Config
      match /config/{docId} {
        allow read, write: if isShopOwner(shopId) || isSuperAdmin();
      }

      // Shifts
      match /shifts/{shiftId} {
        allow read, write: if isShopOwner(shopId) || isSuperAdmin();
      }
    }

    // ----------------------------------------------------------------//
    //                  COLLECTION GROUP QUERIES                       //
    // ----------------------------------------------------------------//
    match /{path=**}/employees/{employeeId} {
      allow get, list: if isOwnerOfResourceShop() || request.auth.uid == resource.data.ownerId || isSuperAdmin();
    }

    match /{path=**}/attendance/{attendanceId} {
      allow get, list: if isOwnerOfResourceShop() || request.auth.uid == resource.data.ownerId || isSuperAdmin();
    }

    match /{path=**}/leaveRequests/{leaveId} {
      allow get, list: if isOwnerOfResourceShop() || request.auth.uid == resource.data.ownerId || isSuperAdmin();
    }

    match /{path=**}/shifts/{shiftId} {
      allow get, list: if isOwnerOfResourceShop() || isSuperAdmin();
    }
  }
}
