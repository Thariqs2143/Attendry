rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------------------//
    //                      HELPER FUNCTIONS                           //
    // ----------------------------------------------------------------//

    // Returns true if the user is signed in.
    function isSignedIn() {
      return request.auth != null;
    }

    // Returns true if the requesting user's UID matches the provided userId.
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Returns true if the user is the owner of the shop document.
    // This is the primary check for admin/owner roles.
    function isShopOwner(shopId) {
      // A user is a shop owner if their UID matches the shopId (the doc ID for the main branch)
      // OR if their UID matches the ownerId field within any shop document.
      return isSignedIn() && (request.auth.uid == shopId || request.auth.uid == get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId);
    }
    
    // Returns true if the user is listed in the specified shop's 'employees' subcollection.
    function isEmployee(shopId) {
      return exists(/databases/$(database)/documents/shops/$(shopId)/employees/$(request.auth.uid));
    }
    
    // Returns true if the user has either owner or employee permissions for a given shop.
    function isOwnerOrEmployee(shopId) {
      return isShopOwner(shopId) || isEmployee(shopId);
    }

    // Returns true if a user is trying to read/write their own document.
    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // ----------------------------------------------------------------//
    //                          GLOBAL RULES                           //
    // ----------------------------------------------------------------//

    // The 'users' collection stores a global profile for every user, admin or employee.
    match /users/{userId} {
      allow read: if isSelf(userId) || isShopOwner(resource.data.shopId);
      // A user can create their own document.
      // A shop owner can create a document for a new employee.
      allow create: if isSelf(userId) || isShopOwner(request.resource.data.shopId);
      // A user can update their own profile.
      allow update: if isSelf(userId);
      // A user can delete their own account.
      allow delete: if isSelf(userId);
    }

    // This collection maps a user's phone number to their shop and employee ID.
    // It's critical for phone-based login and for ensuring phone numbers are unique.
    match /employee_phone_to_shop_lookup/{phone} {
      // Any authenticated user can read this to find their shop during login.
      allow read: if isSignedIn();
      // An owner can create this record when inviting an employee.
      // A new user can create this when they sign up for the first time.
      allow create: if isSignedIn();
      // An owner can update this record (e.g., during employee transfer) or the user themselves.
      allow update: if isShopOwner(request.resource.data.shopId) || (isSignedIn() && request.auth.token.phone_number == phone);
       // An owner can delete this when an employee is removed.
      allow delete: if isShopOwner(resource.data.shopId);
    }
    
    // The 'platform_config' collection is for super-admin level configurations.
    match /platform_config/{docId} {
        allow read: if true; // All users can read announcements.
        // Write access is restricted to the super admin only.
        allow write: if isSignedIn() && request.auth.token.phone_number == "+919790296771";
    }

    // ----------------------------------------------------------------//
    //                     SHOP-SPECIFIC RULES                         //
    // ----------------------------------------------------------------//
    
    match /shops/{shopId} {
      // An owner or employee can read their own shop's details.
      allow get, read: if isOwnerOrEmployee(shopId);
      allow list: if isSignedIn();
      // A user can create their own initial shop document upon signup.
      allow create: if isSelf(request.resource.data.ownerId);
      // Only the shop owner can update or delete their shop.
      allow update, delete: if isShopOwner(shopId);

      // --- Subcollection Rules ---

      // Employees are stored in a subcollection under their respective shop.
      match /employees/{employeeId} {
        // A shop owner can create new employee records (invites).
        allow create: if isShopOwner(shopId);
        // An owner or any employee of the same shop can view employee profiles.
        // A user can also view their own profile.
        allow read: if isOwnerOrEmployee(shopId) || isSelf(employeeId);
        // An owner can update any employee. An employee can update their own profile.
        allow update: if isShopOwner(shopId) || isSelf(employeeId);
        // Only the owner can delete an employee.
        allow delete: if isShopOwner(shopId);
      }

      // Attendance records are specific to each shop.
      match /attendance/{attendanceId} {
        // Any employee of the shop can create an attendance record (check-in).
        allow create: if isEmployee(shopId);
        // An owner can view all records. An employee can only view their own.
        allow read, list: if isOwnerOrEmployee(shopId);
        // An owner can edit any record. An employee can only edit their own (e.g., check-out).
        allow update: if isShopOwner(shopId) || (isEmployee(shopId) && request.resource.data.userId == request.auth.uid);
        // Only the owner can delete records.
        allow delete: if isShopOwner(shopId);
      }
      
      // Leave requests are managed per shop.
      match /leaveRequests/{leaveId} {
          allow create: if isEmployee(shopId) && request.resource.data.userId == request.auth.uid;
          allow read, list: if isOwnerOrEmployee(shopId);
          // Only the owner can approve, deny (update) or delete leave requests.
          allow update, delete: if isShopOwner(shopId);
      }

      // QR Code history, general settings, and shifts can only be managed by the shop owner.
      match /qr-history/{docId} {
        allow read, write: if isShopOwner(shopId);
      }
      match /config/{docId} {
        allow read, write: if isShopOwner(shopId);
      }
      match /shifts/{shiftId} {
        allow read, write: if isShopOwner(shopId);
      }
    }
  }
}
