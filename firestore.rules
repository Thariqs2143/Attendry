
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------
    // Helper Functions
    // ----------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isShopOwner(shopId) {
      return isSignedIn() && get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId == request.auth.uid;
    }

    function isEmployeeOfShop(shopId) {
      return isSignedIn() && exists(/databases/$(database)/documents/shops/$(shopId)/employees/$(request.auth.uid));
    }
    
    function isSuperAdmin() {
      return request.auth.uid == "9x42M1n2aPVAH8ygeZt1Jc3A4e52";
    }

    // ----------------------
    // Users Collection
    // ----------------------
    match /users/{userId} {
      // Any signed-in user can create their own user document.
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      
      // Users can read and update their own profile. Shop owners can read their employees' profiles.
      allow read, update: if isOwner(userId) || isShopOwner(resource.data.shopId);
      
      // Only the user or a super admin can delete a user profile.
      allow delete: if isOwner(userId) || isSuperAdmin();

      // Admins can list their own employees.
      allow list: if isSignedIn() && isShopOwner(request.query.shopId);
    }
    
    // Platform-wide config (for announcements, etc.)
    match /platform_config/{docId} {
        allow read;
        allow write: if isSuperAdmin();
    }

    // ----------------------
    // Shops Collection
    // ----------------------
    match /shops/{shopId} {
      // Owners can do anything to their own shop document.
      allow create: if isShopOwner(shopId);
      allow update, delete: if isShopOwner(shopId) || isSuperAdmin();
      
      // An owner or an employee can read the shop they belong to.
      allow read: if isShopOwner(shopId) || isEmployeeOfShop(shopId) || isSuperAdmin();

      // Authenticated users can query for shops they own.
      allow list: if isSignedIn() || isSuperAdmin();

      // Employees Subcollection
      match /employees/{employeeId} {
        // Shop owner can manage employees.
        allow create, delete, update: if isShopOwner(shopId) || isSuperAdmin();
        // Employees can read their own data.
        allow read: if isOwner(employeeId) || isShopOwner(shopId) || isEmployeeOfShop(shopId);
      }

      // Attendance Subcollection
      match /attendance/{recordId} {
        allow read, list: if isShopOwner(shopId) || (isEmployeeOfShop(shopId) && resource.data.userId == request.auth.uid);
        allow create: if isEmployeeOfShop(shopId) && request.resource.data.userId == request.auth.uid;
        allow update: if isShopOwner(shopId) || (isEmployeeOfShop(shopId) && resource.data.userId == request.auth.uid);
        allow delete: if isShopOwner(shopId) || isSuperAdmin();
      }

      // Leave Requests Subcollection
      match /leaveRequests/{requestId} {
        allow read, list: if isShopOwner(shopId) || (isEmployeeOfShop(shopId) && resource.data.userId == request.auth.uid);
        allow create: if isEmployeeOfShop(shopId) && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isShopOwner(shopId) || isSuperAdmin();
      }

      // Other Subcollections
      match /qr-history/{docId} {
        allow read, write: if isShopOwner(shopId) || isSuperAdmin();
      }
      match /config/{docId} {
        allow read, write: if isShopOwner(shopId) || isSuperAdmin();
      }
      match /shifts/{shiftId} {
          allow read, write: if isShopOwner(shopId) || isSuperAdmin();
      }
    }
  }
}
