rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------
    // Helper Functions
    // ----------------------

    function isSignedIn() {
      return request.auth != null;
    }

    // Check if the user is the owner of a given document/ID
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Check if the currently authenticated user is the owner of a specific shop
    function isShopOwner(shopId) {
      // The owner's UID is the same as the shop's document ID
      return isSignedIn() && request.auth.uid == shopId;
    }
    
    // Check if a user is an employee of a specific shop
    function isEmployee(shopId) {
      return exists(/databases/$(database)/documents/shops/$(shopId)/employees/$(request.auth.uid));
    }

    // ----------------------
    // Users Collection
    // ----------------------
    match /users/{userId} {
      // A user can read or update their own profile.
      allow read, update: if isOwner(userId);

      // A user can create their own document (e.g., on first sign-up).
      // A shop owner can create a document for a new employee they are inviting.
      allow create: if isOwner(userId) || 
                      (isSignedIn() && 
                       exists(/databases/$(database)/documents/shops/$(request.auth.uid)));

      // Only the user can delete their own profile.
      allow delete: if isOwner(userId);
    }

    // ----------------------
    // Shops Collection
    // ----------------------
    match /shops/{shopId} {

      // Only the shop owner can create, update, or delete their shop document.
      allow create, update, delete: if isShopOwner(shopId);

      // The owner or an employee can read the shop document.
      allow read: if isShopOwner(shopId) || isEmployee(shopId);
      
      // Any authenticated user can list shops (e.g., for a search feature).
      allow list: if isSignedIn();

      // ----------------------
      // Employees Subcollection
      // ----------------------
      match /employees/{employeeId} {
        // The shop owner can create, update, and delete employee records.
        allow create, update, delete: if isShopOwner(shopId);

        // An employee can read their own record, and the owner can read all employee records.
        allow read: if isOwner(employeeId) || isShopOwner(shopId);
      }

      // ----------------------
      // Attendance Subcollection
      // ----------------------
      match /attendance/{attendanceId} {
        // An employee can create their own attendance record, or the owner can create one manually.
        allow create: if (isEmployee(shopId) && request.resource.data.userId == request.auth.uid)
                      || isShopOwner(shopId);

        // An owner can read/write all records; an employee can only access their own.
        allow read, write: if isShopOwner(shopId)
                           || (isEmployee(shopId) && resource.data.userId == request.auth.uid);
      }

      // ----------------------
      // Leave Requests Subcollection
      // ----------------------
      match /leaveRequests/{leaveId} {
        // An employee can create their own leave request.
        allow create: if isEmployee(shopId)
                      && request.resource.data.userId == request.auth.uid;
        
        // An owner can manage all requests; an employee can access their own.
        allow read, write: if isShopOwner(shopId)
                           || (isEmployee(shopId) && resource.data.userId == request.auth.uid);
      }
      
      // ----------------------
      // Config, QR History, Shifts (Owner only)
      // ----------------------
      match /config/{docId} {
        allow read, write: if isShopOwner(shopId);
      }

      match /qr-history/{docId} {
        allow read, write: if isShopOwner(shopId);
      }
      
      match /shifts/{shiftId} {
        allow read, write: if isShopOwner(shopId);
      }
    }
  }
}
