rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------
    // Helper Functions
    // ----------------------

    function isSignedIn() {
      return request.auth != null;
    }

    // Check if the user is the owner of a given document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Shop owner check
    function isShopOwner(shopId) {
      return isSignedIn() &&
             (request.auth.uid == shopId ||
              request.auth.uid == get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId);
    }

    // Check if resource belongs to the shop owned by this user
    function isOwnerOfResourceShop() {
      return isSignedIn() &&
             resource.data.shopId != null &&
             isShopOwner(resource.data.shopId);
    }

    // Employee check (exists under shop's subcollection or users collection)
    function isEmployeeByUsersCollection(shopId) {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Employee' &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.shopId == shopId;
    }

    function isEmployeeBySubcollection(shopId) {
      return exists(/databases/$(database)/documents/shops/$(shopId)/employees/$(request.auth.uid));
    }

    function isEmployee(shopId) {
      return isEmployeeByUsersCollection(shopId) || isEmployeeBySubcollection(shopId);
    }

    function isOwnerOrEmployee(shopId) {
      return isShopOwner(shopId) || isEmployee(shopId);
    }

    // ----------------------
    // Users Collection
    // ----------------------
    match /users/{userId} {
      // Allow a user to read/update their own profile
      allow read, update: if isOwner(userId);

      // Allow create if it's their own UID
      allow create: if request.auth.uid == userId;

      // Super admin-style delete protection could be added here if needed
      allow delete: if isOwner(userId);
    }

    // ----------------------
    // Shops Collection
    // ----------------------
    match /shops/{shopId} {

      // Owners can do anything to their shop
      allow create, update, delete: if isShopOwner(shopId);

      // Allow read for owner or employee
      allow read, get: if isShopOwner(shopId) || isEmployee(shopId);

      // Any authenticated user can list/search shops
      allow list: if isSignedIn();

      // ----------------------
      // Employees Subcollection
      // ----------------------
      match /employees/{employeeId} {
        // Owner can manage employees
        allow create, update, delete: if isShopOwner(shopId);

        // Employees can read their own document
        allow read: if isOwner(employeeId) || isShopOwner(shopId);
      }

      // ----------------------
      // Attendance Subcollection
      // ----------------------
      match /attendance/{attendanceId} {
        // Employee can create for themselves; owner can do anything
        allow create: if isEmployee(shopId) && request.auth.uid == request.resource.data.userId
                      || isShopOwner(shopId);

        // Owner can read/write all; employees can read their own
        allow read, write: if isShopOwner(shopId)
                           || (isEmployee(shopId) && resource.data.userId == request.auth.uid);
      }

      // ----------------------
      // Leave Requests Subcollection
      // ----------------------
      match /leaveRequests/{leaveId} {
        allow create: if isEmployee(shopId)
                      && request.resource.data.userId == request.auth.uid;
        allow read, write: if isShopOwner(shopId)
                           || (isEmployee(shopId)
                               && resource.data.userId == request.auth.uid);
      }

      // ----------------------
      // Config / Shifts / QR History (Owner only)
      // ----------------------
      match /config/{docId} {
        allow read, write: if isShopOwner(shopId);
      }

      match /qr-history/{docId} {
        allow read, write: if isShopOwner(shopId);
      }

      match /shifts/{shiftId} {
        allow read, write: if isShopOwner(shopId);
      }
    }

    // ----------------------
    // Collection Group Queries (for dashboards/admin views)
    // ----------------------
    match /{path=**}/employees/{employeeId} {
      allow get, list: if isOwnerOfResourceShop();
    }

    match /{path=**}/attendance/{attendanceId} {
      allow get, list: if isOwnerOfResourceShop();
    }

    match /{path=**}/leaveRequests/{leaveId} {
      allow get, list: if isOwnerOfResourceShop();
    }

    match /{path=**}/shifts/{shiftId} {
      allow get, list: if isOwnerOfResourceShop();
    }
  }
}
